server {
    listen 80;
    server_name core.bgnhub.me;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen 443 quic;
    http2 on;
    http3 on;
    server_name core.bgnhub.me;

    ssl_certificate     /etc/letsencrypt/live/core.bgnhub.me/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/core.bgnhub.me/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # Announce HTTP/3 support to browsers
    add_header Alt-Svc 'h3=":443"; ma=86400' always;
    add_header Strict-Transport-Security "max-age=63072000" always;

    client_max_body_size 10m;

    # Service-to-service endpoints. Only business modules on the docker
    # network call these (blog -> http://app:8080); they must never be
    # reachable from the public internet. GET /api/permissions/registry
    # (list modules, authenticated) stays available for the admin UI.
    location ^~ /api/permissions/check {
        return 403;
    }

    location ^~ /api/permissions/registry {
        limit_except GET HEAD { return 403; }
        proxy_pass http://127.0.0.1:9000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:9000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
